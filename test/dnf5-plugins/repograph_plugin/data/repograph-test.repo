=Ver: 3.0

# Test repository for repograph unit tests. Designed to exercise:
#  - Strong, recommended, and suggested dependencies
#  - Multiple providers per reldep (alternates for libb-runtime)
#  - A self-provider with an alternative provider
#  - Package-name merging (two arches and versions of liba)
#  - Isolated nodes and the union of dependencies across merged packages
#  - Unresolved dependencies (app -> optional-pkg has no provider)

# Root package with strong, virtual, weak, and unresolved dependencies.
=Pkg: app 1.0 1 x86_64
=Prv: app = 1.0-1
=Req: liba.so.1()(64bit)
=Req: libb-runtime
=Rec: bonus
=Sug: suggestion
=Req: optional-pkg

# The liba builds share a dependency and each has a distinct dependency.
# All builds must contribute to the single merged node's outgoing edges.
=Pkg: liba 1.2 1 x86_64
=Prv: liba.so.1()(64bit)
=Prv: liba = 1.2-1
=Req: liba-common
=Req: liba-x86-64

=Pkg: liba 1.2 1 i686
=Prv: liba.so.1
=Prv: liba = 1.2-1
=Req: liba-common
=Req: liba-i686

=Pkg: liba 2.0 1 x86_64
=Prv: liba.so.1()(64bit)
=Prv: liba = 2.0-1
=Req: liba-common
=Req: liba-new-version

=Pkg: liba-common 1.0 1 noarch
=Prv: liba-common

=Pkg: liba-x86-64 1.0 1 noarch
=Prv: liba-x86-64

=Pkg: liba-i686 1.0 1 noarch
=Prv: liba-i686

=Pkg: liba-new-version 1.0 1 noarch
=Prv: liba-new-version

# Two packages provide libb-runtime; the graph selects one provider.
=Pkg: libb-impl1 1.0 1 x86_64
=Prv: libb-runtime = 1.0-1
=Prv: libb-impl1 = 1.0-1

=Pkg: libb-impl2 1.0 1 x86_64
=Prv: libb-runtime = 1.0-1
=Prv: libb-impl2 = 1.0-1

# Recommended package. Included only when include_recommends is true.
=Pkg: bonus 1.0 1 x86_64
=Prv: bonus = 1.0-1

# Suggested package. Suggests are hints and do not produce graph edges.
=Pkg: suggestion 1.0 1 x86_64
=Prv: suggestion = 1.0-1

# The requiring package satisfies its own dependency, even though an
# alphabetically earlier alternative provider is available.
=Pkg: self-provider 1.0 1 x86_64
=Prv: self-provider = 1.0-1
=Prv: shared-capability
=Req: shared-capability

=Pkg: alternative-provider 1.0 1 x86_64
=Prv: alternative-provider = 1.0-1
=Prv: shared-capability

# Neither requires nor is required by any other package.
=Pkg: isolated 1.0 1 noarch
=Prv: isolated
